# Copiez ce fichier en `.env` et ajustez les valeurs si besoin.
# Toutes ces variables sont optionnelles : le scraper fonctionne avec des
# valeurs par défaut raisonnables.

# Mode headless forcé (0 = fenêtre visible / recommandé, 1 = sans fenêtre / déconseillé)
HEADLESS=0

# Nombre de fiches extraites en parallèle (vitesse). 1 = séquentiel, 3 = défaut.
# Plus c'est élevé, plus c'est rapide, mais plus le risque de blocage augmente.
CONCURRENCE=3

# Mode rapide (1 = délais anti-détection réduits). Plus rapide, plus risqué.
MODE_RAPIDE=0

# Taille de la fenêtre du navigateur
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900

# Timeout global de navigation (ms)
NAV_TIMEOUT_MS=30000

# Délai (ms) entre deux fiches, tiré aléatoirement entre ces bornes
DELAI_FICHE_MIN_MS=1200
DELAI_FICHE_MAX_MS=3000

# Délai (ms) entre deux scrolls du panneau de résultats
DELAI_SCROLL_MIN_MS=800
DELAI_SCROLL_MAX_MS=2200

# Pause longue (ms) toutes les 20 fiches, tirée aléatoirement entre ces bornes
PAUSE_LONGUE_MIN_MS=15000
PAUSE_LONGUE_MAX_MS=40000

# Répertoire de sortie (relatif à la racine du projet)
OUTPUT_DIR=data/output
